{
  "name": "plausible-mcp",
  "version": "0.1.3",
  "description": "Plausible Analytics MCP server: privacy-first website statistics, real-time visitors, breakdowns, and trendlines for AI agents",
  "author": {
    "name": "Surendran B",
    "url": "https://github.com/surendranb"
  },
  "mcpServers": {
    "plausible-mcp": {
      "command": "uvx",
      "args": [
        "plausible-mcp==0.1.3"
      ],
      "env": {
        "PLAUSIBLE_API_KEY": "${PLAUSIBLE_API_KEY}",
        "PLAUSIBLE_SITE_ID": "${PLAUSIBLE_SITE_ID}"
      }
    }
  }
}
